rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Reglas para fotos de lecturas del medidor
    match /users/{userId}/meters/{meterId}/readings/{readingId}/{fileName} {

      // Solo el dueño puede leer sus fotos
      allow read: if request.auth != null && request.auth.uid == userId;

      // Solo el dueño puede crear/actualizar fotos
      // Validar que sea imagen JPEG menor a 5MB
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.contentType.matches('image/jpeg')
                   && request.resource.size < 5 * 1024 * 1024;

      // Solo el dueño puede eliminar
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Denegar acceso a cualquier otra ruta
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
